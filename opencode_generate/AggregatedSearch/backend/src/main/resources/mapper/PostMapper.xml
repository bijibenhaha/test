<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.search.mapper.PostMapper">

    <select id="listPostWithDelete" resultType="com.example.search.model.entity.Post">
        select *
        from post
        where updateTime >= #{minUpdateTime}
    </select>
</mapper>
